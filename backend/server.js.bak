  if (name) item.name = name;
  if (department) item.department = department;
  if (criticality) item.criticality = criticality;
  res.json(item);
});
app.delete("/api/setup/standards/:id", (req, res) => {
  standards = standards.filter((s) => s._id !== req.params.id);
